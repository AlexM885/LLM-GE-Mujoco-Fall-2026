# Copy to .env and fill in your API key.
#
# LIMEN uses an OpenAI-compatible client, so the same env var works for any
# provider. Set api_base in your YAML config to point at the right endpoint:
#   - OpenRouter:  https://openrouter.ai/api/v1   (default)
#   - OpenAI:      https://api.openai.com/v1
#   - Together:    https://api.together.xyz/v1
#   - Groq:        https://api.groq.com/openai/v1
#   - vLLM/Ollama: http://localhost:8000/v1

OPENAI_API_KEY=your-key-here
