#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_PATH="${1:-${DATA_PATH:-}}"

if ! command -v sbatch >/dev/null 2>&1; then
  echo "Error: sbatch was not found. Run this command on a SLURM login node." >&2
  exit 127
fi

if [[ -z "$DATA_PATH" ]]; then
  echo "Usage: $0 /absolute/path/to/cifar10" >&2
  echo "The CIFAR-10 dataset must be prepared with ExquisiteNetV2/split.py first." >&2
  exit 2
fi

if [[ ! -d "$DATA_PATH" ]]; then
  echo "Error: dataset directory does not exist: $DATA_PATH" >&2
  exit 2
fi

export DATA_PATH
exec sbatch "$ROOT_DIR/run_AgenticIslands.sh"
